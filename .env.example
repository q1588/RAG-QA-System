# ===== 应用 =====
APP_NAME=基于大模型的RAG知识库问答系统

# ===== 数据库（默认 SQLite 零依赖即跑；Docker 部署时改为 MySQL）=====
# 本地开发：
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Docker/生产（MySQL 8）：
# DATABASE_URL=mysql+asyncmy://rag_user:rag_pass@db:3306/rag_db?charset=utf8mb4
DB_ECHO=false

# ===== 认证（生产环境务必更换 SECRET！）=====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Ollama（本地大模型）=====
# 本机运行：
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker 容器访问宿主机的 Ollama：
# OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:3b

# ===== RAG =====
CHROMA_DIR=./chroma_store
UPLOAD_DIR=./upload_files
CHUNK_SIZE=500
CHUNK_OVERLAP=60
TOP_K=3
# 相关性阈值：低于此值（0~1）视为知识库无相关内容，直接如实回答而非让大模型编造
RAG_RELEVANCE_THRESHOLD=0.5
MAX_CONTEXT_HISTORY=8
