# ===== 应用 =====
APP_NAME=基于大模型的RAG知识库问答系统

# ===== 数据库（默认 SQLite 零依赖即跑；Docker 部署时改为 MySQL）=====
# 本地开发：
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Docker/生产（MySQL 8）：
# DATABASE_URL=mysql+asyncmy://rag_user:rag_pass@db:3306/rag_db?charset=utf8mb4
DB_ECHO=false

# ===== 认证（生产环境务必更换 SECRET！）=====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 上传文档大小上限（MB）
MAX_UPLOAD_SIZE_MB=20

# ===== 向量数据库（Milvus）=====
# 本地开发：Milvus Lite 单文件（零依赖，自动创建）
MILVUS_URL=./milvus_store/rag.db
# Docker/生产：连接独立 Milvus 服务（docker-compose 已内置）
# MILVUS_URL=http://milvus:19530
MILVUS_COLLECTION=rag_docs
# 可选：Milvus 鉴权 token / Zilliz Cloud API Key
# MILVUS_TOKEN=
MILVUS_METRIC_TYPE=COSINE

# ===== Embedding（在线 API，OpenAI 兼容协议）=====
# provider = openai（在线，推荐） | ollama（本地 Ollama 兜底）
EMBEDDING_PROVIDER=openai
# SiliconFlow（国内直连，默认模型 BAAI/bge-m3，1024 维）：
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBED_MODEL=BAAI/bge-m3
# 其它可选端点：
#   OpenAI 官方：   EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBED_MODEL=text-embedding-3-large
#   阿里云百炼：    EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBED_MODEL=text-embedding-v3
#   DeepSeek：      EMBEDDING_BASE_URL=https://api.deepseek.com/v1  EMBED_MODEL=deepseek-embedding
# 离线兜底（不填 KEY 时请改为）：
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBED_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=10  # 向量化批大小（百炼兼容接口上限 10；OpenAI 官方可调大）

# ===== LLM（在线 API，OpenAI 兼容协议，提升并发能力）=====
# provider = openai（在线，推荐） | ollama（本地 Ollama 兜底）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 其它可选端点：
#   OpenAI 官方： LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   阿里云百炼：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   DeepSeek：    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   Moonshot：    LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=moonshot-v1-8k
# 离线兜底：
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Ollama 本地模型（provider=ollama 时使用；兼容旧配置键）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:3b

# ===== 切块策略 =====
# recursive（递归） | semantic（语义） | hybrid（混合：递归 + 语义合并）
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=60
# 语义切分参数
SEMANTIC_BREAKPOINT_PERCENTILE=95.0
SEMANTIC_MIN_CHUNK_CHARS=100
SEMANTIC_MAX_CHUNK_CHARS=1200
SEMANTIC_MERGE_THRESHOLD=0.8

# ===== 检索 =====
TOP_K=3
# 相关性阈值：低于此值（余弦相似度 0~1）视为知识库无相关内容，直接如实回答而非让大模型编造
# ⚠️ 0.5 仅为初始值：不同 Embedding 模型下「无关文本」的余弦基线不同
#    （如 bge-m3 常在 0.3~0.6）。请用 scripts/eval_rag.py --embeddings real 的
#    eval_report.json 查看检索分数分布后校准，避免误拒/误收。
RAG_RELEVANCE_THRESHOLD=0.5
MAX_CONTEXT_HISTORY=8

# ===== RAG 评估（scripts/eval_rag.py）=====
# EVAL_DATASET=./data/eval_dataset.jsonl
# EVAL_CORPUS_DIR=./data/eval_corpus